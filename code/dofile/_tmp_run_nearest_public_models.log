Panel variable: hospital_id (unbalanced)
 Time variable: year, 2012 to 2019
         Delta: 1 unit

. 
. capture confirm string variable public

. if !_rc rename public ownership_type

. else {
.     capture confirm variable public
.     if !_rc drop public
. }

. 
. capture confirm numeric variable county_id

. if !_rc gen long county_id_num = county_id
(34 missing values generated)

. else destring county_id, gen(county_id_num)

. 
. gen long prov_id = floor(county_id_num / 10000) if !missing(county_id_num)
(34 missing values generated)

. gen byte public = (public_flag == 1) if !missing(public_flag)

. gen byte post_policy = (year >= policy_year) if !missing(year, policy_year)
(34 missing values generated)

. gen int rel = year - policy_year if !missing(year, policy_year)
(34 missing values generated)

. gen byte sample_nearest_public = inrange(year, 2012, 2019) ///
>     & policy_year > 2012 & public == 1 ///
>     & !missing(county_id_num, prov_id, pharm_nearest_pub_le500m, ///
>         pharm_nearest_pub_le1km, pharm_nearest_pub_le2km, ///
>         pharm_nearest_pub_gt2km)

. 
. gen int g_csdid = policy_year if public == 1 & policy_year > 2012
(111,820 missing values generated)

. gen byte ev_le_m4 = (rel <= -4) if sample_nearest_public
(111,820 missing values generated)

. gen byte ev_m3 = (rel == -3) if sample_nearest_public
(111,820 missing values generated)

. gen byte ev_m2 = (rel == -2) if sample_nearest_public
(111,820 missing values generated)

. gen byte ev_0 = (rel == 0) if sample_nearest_public
(111,820 missing values generated)

. gen byte ev_p1 = (rel == 1) if sample_nearest_public
(111,820 missing values generated)

. gen byte ev_p2 = (rel == 2) if sample_nearest_public
(111,820 missing values generated)

. gen byte ev_p3 = (rel == 3) if sample_nearest_public
(111,820 missing values generated)

. gen byte ev_ge_p4 = (rel >= 4) if sample_nearest_public
(111,820 missing values generated)

. 
